import RowmapLean.Map
import RowmapLean.Ros34pw2

/-!
`lake env lean --run DumpSchedule.lean [path]` writes the MAP schedule(s) as
TOML (default `schedule.toml`). It runs in the interpreter: a compiled
executable would require compiling all of Mathlib natively. The Rust test
`map::tests::schedule_matches_lean` compares them with the `const` tables in
`src/map.rs`.
-/

open Rowmap

def stageToml (key : String) : StageKind → String
  | .arnoldi => s!"[[{key}]]\nkind = \"arnoldi\"\n"
  | .extend ins r => s!"[[{key}]]\nkind = \"extend\"\ninsert = {ins}\nrounds = {r}\n"

def scheduleToml : String :=
  "# Generated by `lake env lean --run DumpSchedule.lean` from RowmapLean/Map.lean.\n" ++
  "# Do not edit.\n" ++
  "# Checked against src/map.rs by `cargo test schedule_matches_lean`.\n\n" ++
  String.intercalate "\n" (grk4tAutonomous.map (stageToml "grk4t_autonomous")) ++ "\n" ++
  String.intercalate "\n" (grk4tNonautonomous.map (stageToml "grk4t_nonautonomous")) ++ "\n" ++
  String.intercalate "\n" (ros34pw2Autonomous.map (stageToml "ros34pw2_autonomous")) ++ "\n" ++
  String.intercalate "\n" (ros34pw2Nonautonomous.map (stageToml "ros34pw2_nonautonomous"))

def main (args : List String) : IO Unit := do
  let path := args.headD "schedule.toml"
  IO.FS.writeFile path scheduleToml
  IO.println s!"wrote {path}"
